    <script>
        // Inicializar ícones
        lucide.createIcons();

        // Scroll reveal
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // Barra de progresso
        window.addEventListener('scroll', () => {
            const scrollTop = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            const progress = (scrollTop / docHeight) * 100;
            document.getElementById('progress-bar').style.width = progress + '%';
            
            // Botão voltar ao topo
            const btn = document.getElementById('back-to-top');
            if (scrollTop > 500) btn.classList.add('visible');
            else btn.classList.remove('visible');
        });

        // Modais
        function openModal(id) {
            const modal = document.getElementById(id);
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }
        function closeModal(id) {
            const modal = document.getElementById(id);
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }
        // Fechar modal clicando fora
        document.querySelectorAll('.modal-backdrop').forEach(modal => {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                    document.body.style.overflow = '';
                }
            });
        });

        // QUIZ
        const quizData = [
            {
                question: "Segundo a Logoterapia, qual é a principal motivação do ser humano?",
                options: ["Buscar prazer e evitar dor", "Buscar poder e reconhecimento", "Buscar sentido e propósito", "Buscar segurança e estabilidade"],
                correct: 2,
                explanation: "Frankl propõe que a 'vontade de sentido' é a motivação primária — diferente de Freud (prazer) e Adler (poder)."
            },
            {
                question: "O que significa 'autotranscendência'?",
                options: ["Superar-se fisicamente em desafios", "Ir além de si mesmo em direção a algo ou alguém", "Transcender a realidade através da meditação", "Alcançar um estado de perfeição interior"],
                correct: 1,
                explanation: "Autotranscendência é o movimento de sair de si mesmo em direção ao mundo — a uma causa a servir ou uma pessoa a amar."
            },
            {
                question: "Qual das alternativas NÃO é uma via de descoberta de sentido segundo Frankl?",
                options: ["Valores criativos (o que damos ao mundo)", "Valores vivenciais (o que recebemos do mundo)", "Valores materiais (o que acumulamos)", "Valores atitudinais (a postura diante do inevitável)"],
                correct: 2,
                explanation: "Os três caminhos são: criativo, vivencial e atitudinal. Valores materiais não são uma via de sentido na Logoterapia."
            },
            {
                question: "Diante de um sofrimento inevitável, o que a Logoterapia propõe?",
                options: ["Evitar pensar nele a todo custo", "Transformar a tragédia em conquista humana através da atitude", "Buscar imediatamente um tratamento médico", "Aceitar passivamente sem questionar"],
                correct: 1,
                explanation: "Quando não podemos mudar a situação, somos desafiados a mudar a nós mesmos — encontrando sentido na atitude que tomamos."
            },
            {
                question: "O que é o 'vácuo existencial'?",
                options: ["Um estado de meditação profunda", "Um vazio interior pela frustração da vontade de sentido", "Um conceito da física quântica", "Uma técnica de relaxamento"],
                correct: 1,
                explanation: "O vácuo existencial surge quando a vontade de sentido é frustrada, gerando vazio, tédio e, muitas vezes, comportamentos compensatórios."
            },
            {
                question: "Segundo Frankl, a liberdade humana consiste principalmente em:",
                options: ["Fazer o que se quer sem restrições", "Escolher a própria atitude diante das circunstâncias", "Viver sem responsabilidades", "Eliminar todas as limitações da vida"],
                correct: 1,
                explanation: "Não somos livres 'de' condições, mas livres 'para' escolher como responder a elas — essa é a última liberdade humana."
            },
            {
                question: "Qual é a relação entre finitude (morte) e sentido na Logoterapia?",
                options: ["A morte torna a vida sem sentido", "A finitude dá urgência e valor às nossas escolhas", "A morte é irrelevante para a questão do sentido", "Só se encontra sentido após aceitar a morte"],
                correct: 1,
                explanation: "A transitoriedade não torna a vida sem sentido — pelo contrário, cria a responsabilidade de aproveitá-la ao máximo."
            }
        ];

        let currentQuestion = 0;
        let score = 0;
        let answered = [];

        function renderQuiz() {
            const container = document.getElementById('quiz-container');
            if (currentQuestion >= quizData.length) {
                showResult();
                return;
            }
            const q = quizData[currentQuestion];
            container.innerHTML = `
                <div class="mb-6">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-semibold text-slate-500">Pergunta ${currentQuestion + 1} de ${quizData.length}</span>
                        <span class="text-xs font-semibold text-teal-700">${score} acerto${score !== 1 ? 's' : ''}</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-1.5 mb-6">
                        <div class="bg-gradient-to-r from-teal-500 to-emerald-600 h-1.5 rounded-full transition-all" style="width: ${(currentQuestion / quizData.length) * 100}%"></div>
                    </div>
                    <h3 class="font-serif text-2xl font-bold text-slate-900 mb-6">${q.question}</h3>
                    <div class="space-y-3">
                        ${q.options.map((opt, i) => `
                            <button onclick="answerQuestion(${i})" class="quiz-option w-full text-left p-4 bg-slate-50 hover:bg-teal-50 border-2 border-slate-200 hover:border-teal-400 rounded-xl text-sm text-slate-700 font-medium transition">
                                ${opt}
                            </button>
                        `).join('')}
                    </div>
                    <div id="feedback" class="mt-6 hidden"></div>
                </div>
            `;
        }

        function answerQuestion(idx) {
            const q = quizData[currentQuestion];
            const buttons = document.querySelectorAll('.quiz-option');
            buttons.forEach((btn, i) => {
                btn.classList.add('disabled');
                btn.onclick = null;
                if (i === q.correct) btn.classList.add('quiz-correct');
                else if (i === idx) btn.classList.add('quiz-wrong');
            });
            
            if (idx === q.correct) score++;
            
            const feedback = document.getElementById('feedback');
            feedback.classList.remove('hidden');
            feedback.innerHTML = `
                <div class="p-4 rounded-xl ${idx === q.correct ? 'bg-emerald-50 border border-emerald-200' : 'bg-amber-50 border border-amber-200'}">
                    <p class="text-sm font-semibold ${idx === q.correct ? 'text-emerald-900' : 'text-amber-900'} mb-1">
                        ${idx === q.correct ? '✨ Isso mesmo!' : '💭 Não exatamente, mas veja:'}
                    </p>
                    <p class="text-sm text-slate-700">${q.explanation}</p>
                </div>
                <button onclick="nextQuestion()" class="mt-4 w-full bg-slate-900 text-white py-3 rounded-xl font-semibold text-sm hover:bg-slate-800 transition">
                    ${currentQuestion === quizData.length - 1 ? 'Ver resultado final' : 'Próxima pergunta →'}
                </button>
            `;
        }

        function nextQuestion() {
            currentQuestion++;
            renderQuiz();
        }

        function showResult() {
            document.getElementById('quiz-container').classList.add('hidden');
            const result = document.getElementById('quiz-result');
            result.classList.remove('hidden');
            const percent = Math.round((score / quizData.length) * 100);
            let message = '';
            if (percent === 100) message = 'Perfeito! Você absorveu profundamente os conceitos.';
            else if (percent >= 70) message = 'Muito bem! Você compreendeu a essência da Logoterapia.';
            else if (percent >= 50) message = 'Bom começo! Que tal revisitar algumas seções?';
            else message = 'Cada jornada tem seu tempo. Volte e explore com calma.';
            
            document.getElementById('quiz-score').innerHTML = `
                Você acertou <strong class="text-teal-700">${score} de ${quizData.length}</strong> perguntas (${percent}%).<br>
                <span class="text-sm italic">${message}</span>
            `;
            lucide.createIcons();
        }

        function restartQuiz() {
            currentQuestion = 0;
            score = 0;
            document.getElementById('quiz-container').classList.remove('hidden');
            document.getElementById('quiz-result').classList.add('hidden');
            renderQuiz();
        }

        renderQuiz();
    </script>
</body>
</html>
