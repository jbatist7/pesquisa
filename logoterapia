                <a href="#autotranscendencia" class="group block bg-gradient-to-br from-teal-600 to-emerald-700 text-white p-5 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 text-center max-w-sm w-full pulse-soft relative">
