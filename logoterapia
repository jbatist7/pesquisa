        <!-- VONTADE DE SENTIDO -->
        <section id="vontade-sentido" class="py-16 reveal scroll-mt-20">
            <div class="flex items-center gap-3 mb-4">
                <span class="w-10 h-10 bg-sky-600 text-white rounded-xl flex items-center justify-center">
